{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Engineering team",
      "type": "debugpy",
      "request": "launch",
      "module": "engineering_team.vscode_optimized.main",
      "cwd": "${workspaceFolder}/src/engineering_team/vscode_optimized",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
